[Unit]
Description=M5Paper schedule host server (ICS -> REST for the M5Paper thin client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=west
WorkingDirectory=/home/west/m5/M5PaperSchedAL/server
ExecStart=/home/west/m5/M5PaperSchedAL/server/.venv/bin/python -m m5sched
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=mixed
Environment=PYTHONUNBUFFERED=1
Environment=M5SCHED_LOG=INFO

[Install]
WantedBy=multi-user.target
